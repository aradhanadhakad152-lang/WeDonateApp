# ==============================================================================
# WE DONATE — Mobile App Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env in the project root if overriding Expo public variables.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Backend API base URL
# - Local Android Emulator: http://10.0.2.2:5000
# - Local Physical Device:   http://<YOUR_LAN_IP>:5000 (e.g. http://192.168.1.100:5000)
# - Production Backend:      https://wedonateapp.onrender.com
EXPO_PUBLIC_API_URL=https://wedonateapp.onrender.com

# Google Maps API Key (Android SDK)
# Used for interactive donor maps and hospital route pins
# Required for native maps display on Android
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy_YOUR_GOOGLE_MAPS_ANDROID_KEY_PLACEHOLDER

# Note: Firebase configuration for Android is loaded via android/app/google-services.json
# (template provided in docs/google-services.json.example).
