# Backend-specific .gitignore

# Environment — NEVER commit
.env
.env.*
!.env.example

# Firebase Service Account Credentials — NEVER commit
firebase-service-account.json
*service-account*.json

# Dependencies
node_modules/

# Logs
logs/
*.log
npm-debug.log*

# Test coverage
coverage/
.nyc_output/

# OS
.DS_Store
Thumbs.db

# Runtime
pids/
*.pid
*.seed
