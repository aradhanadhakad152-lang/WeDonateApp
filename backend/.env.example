# ============================================
# WE DONATE — Production Environment Template
# ============================================

# Environment & Server Configuration
NODE_ENV=production
PORT=5000
API_VERSION=v1
ALLOWED_ORIGINS=https://wedonate.onrender.com,http://localhost:8081

# MongoDB Atlas Production Database Connection
# MUST use a strong password and URL-encoded credentials
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@cluster.mongodb.net/wedonate?retryWrites=true&w=majority

# Cryptographically Secure JWT Secret Tokens (Min 32 random chars)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=c8f7e2a9b4d1c6e3f8a5d2b9e4c1f6a3b8d5e2c9f4a1b6d3e8c5f2a9b4d1c6e3
JWT_REFRESH_SECRET=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d

# Firebase Admin SDK Configuration (we-donate-8170b)
FIREBASE_PROJECT_ID=we-donate-8170b
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@we-donate-8170b.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Nearby Donor Matching Configuration
DEFAULT_MATCHING_RADIUS_KM=10

# Production SMS Provider Configuration
SMS_ENABLED=false
SMS_PROVIDER=TWILIO
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM="+18005550199"
SMS_MAX_DONORS_PER_REQUEST=3
