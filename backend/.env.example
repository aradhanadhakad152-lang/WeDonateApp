# ==============================================================================
# WE DONATE — Backend Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env and replace placeholder values with your configuration.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
# Runtime environment: development | test | production
# Required: No (Default: development)
NODE_ENV=development

# Port where Express HTTP server listens
# Required: No (Default: 5000)
PORT=5000

# API version prefix for routing (/api/v1/...)
# Required: No (Default: v1)
API_VERSION=v1

# Comma-separated allowed CORS origins
# Required: No (Default: localhost:3000, localhost:5000, localhost:8081, wedonateapp.onrender.com)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000,http://localhost:8081

# ------------------------------------------------------------------------------
# 2. MongoDB Database
# ------------------------------------------------------------------------------
# MongoDB connection URI (Atlas or local instance with 2dsphere index support)
# Required: Yes
# Local example: mongodb://127.0.0.1:27017/wedonate
# Atlas example: mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/wedonate?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/wedonate

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Tokens
# ------------------------------------------------------------------------------
# Cryptographically secure secret keys (minimum 32-64 characters)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required: Yes
JWT_ACCESS_SECRET=your_32_character_random_jwt_access_secret_hex_here_min_32_chars
JWT_REFRESH_SECRET=your_32_character_random_jwt_refresh_secret_hex_here_min_32_chars

# Token expiration durations (Zeit ms syntax, e.g. 15m, 30m, 7d, 30d)
# Required: No (Defaults: 30m / 30d)
JWT_ACCESS_EXPIRY=30m
JWT_REFRESH_EXPIRY=30d

# ------------------------------------------------------------------------------
# 4. WhatsApp Cloud API (Meta Graph API)
# ------------------------------------------------------------------------------
# Master switch for WhatsApp OTP authentication and notifications
# Required: No (Default: true for OTP)
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=META_CLOUD_API

# Meta Permanent System User Access Token with whatsapp_business_messaging permissions
# Required: Yes (when WHATSAPP_ENABLED=true)
META_ACCESS_TOKEN=EAA_PLACEHOLDER_META_PERMANENT_SYSTEM_USER_ACCESS_TOKEN

# Phone Number ID from Meta WhatsApp Cloud API Dashboard
# Required: Yes (when WHATSAPP_ENABLED=true)
META_PHONE_NUMBER_ID=100000000000001

# WhatsApp Business Account ID (WABA ID)
# Required: No (discovered automatically via Meta Graph API if omitted)
META_WABA_ID=100000000000002

# Custom verification token for incoming Meta webhooks
# Required: No
META_VERIFY_TOKEN=wedonate_meta_webhook_verification_token_sample

# Meta approved authentication template name and language for OTP
# Required: No (Defaults: wedonate_otp / en)
META_OTP_TEMPLATE_NAME=wedonate_otp
META_OTP_TEMPLATE_LANGUAGE=en

# Meta approved template name for emergency donor dispatch alerts
# Required: No (Defaults: emergency_blood_alert / en)
META_TEMPLATE_NAME=emergency_blood_alert
META_TEMPLATE_LANGUAGE=en

# Max donors notified per emergency request via WhatsApp
# Required: No (Default: 5)
WHATSAPP_MAX_DONORS_PER_REQUEST=5
WHATSAPP_FROM=WE DONATE Emergency

# Alternative fallback provider configurations (if using Twilio / UltraMsg)
TWILIO_ACCOUNT_SID=
ULTRAMSG_INSTANCE_ID=

# ------------------------------------------------------------------------------
# 5. Firebase Admin SDK (Cloud Messaging & Auth Verification)
# ------------------------------------------------------------------------------
# Google Cloud / Firebase Project ID
# Required: Yes (for Firebase Auth verification and push notifications)
FIREBASE_PROJECT_ID=we-donate-demo

# Firebase service account client email
# Required: Yes (for production Firebase Admin SDK)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-demo@we-donate-demo.iam.gserviceaccount.com

# Firebase service account private key (with escaped \n characters)
# Required: Yes (for production Firebase Admin SDK)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 6. Matching Engine & Notification Batches
# ------------------------------------------------------------------------------
# Default radius for searching nearby compatible blood donors (in km)
# Required: No (Default: 10)
DEFAULT_MATCHING_RADIUS_KM=10

# Number of donors included in each notification wave
# Required: No (Default: 5)
DONOR_NOTIFICATION_BATCH_SIZE=5

# Cooldown window (in minutes) before dispatching the next batch if unfilled
# Required: No (Default: 10)
DONOR_NOTIFICATION_RESPONSE_WINDOW_MINUTES=10

# ------------------------------------------------------------------------------
# 7. SMS Gateway Fallback (Optional)
# ------------------------------------------------------------------------------
# Required: No (Default: false)
SMS_ENABLED=false
SMS_PROVIDER=GENERIC
SMS_API_KEY=your_sms_gateway_api_key_placeholder
SMS_FROM=WE DONATE
SMS_MAX_DONORS_PER_REQUEST=3

# ------------------------------------------------------------------------------
# 8. External Integrations (Maps & Payments)
# ------------------------------------------------------------------------------
# Google Maps Server API key for reverse geocoding and routing
# Required: No
GOOGLE_MAPS_API_KEY=AIzaSy_YOUR_GOOGLE_MAPS_SERVER_API_KEY_PLACEHOLDER

# Razorpay Test / Live API Keys for crowdfunding and donations
# Required: No
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key_12345

# ------------------------------------------------------------------------------
# 9. Rate Limiting & Security Controls
# ------------------------------------------------------------------------------
# Sliding window in milliseconds (Default: 900000 = 15 minutes)
# Required: No
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per IP per window
# Required: No (Default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# Bypass rate limiting (set to 'true' only in local automated test runs)
# Required: No (Default: false)
SKIP_RATE_LIMIT=false

# ------------------------------------------------------------------------------
# 10. In-App Mobile Versioning & Updates
# ------------------------------------------------------------------------------
# Version exposed via GET /api/v1/app/version
# Required: No (Default: 1.0.0)
APP_LATEST_VERSION=1.0.0
APP_MINIMUM_VERSION=1.0.0
APP_ANDROID_APK_URL=https://github.com/aradhanadhakad152-lang/WeDonateApp/releases/download/v1.0.0/wedonate-1.0.0.apk
APP_UPDATE_REQUIRED=false
APP_RELEASE_NOTES=Emergency donor matching engine,WhatsApp OTP authentication,Donation camp drive registration
